# Supabase Postgres connection (server-only; never prefix this with NEXT_PUBLIC_).
# Replace [YOUR-PASSWORD] and URL-encode reserved characters in the password.
# For Vercel/serverless, prefer Supabase's Transaction Pooler URL on port 6543
# when available; the direct database URL on port 5432 is also valid.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hcabwlpvwpffwobxnztm.supabase.co:5432/postgres
# DATABASE_URL=postgresql://postgres.hcabwlpvwpffwobxnztm:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=3

# OpenRouter API key (https://openrouter.ai/keys)
# Without it, NovaLens runs in mock mode (synthetic tags, full pipeline still works).
OPENROUTER_API_KEY=

# Optional app URL used for OpenRouter attribution.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional production background removal. When configured, NovaLens stores a
# transparent cutout and a white-background recognition image for every upload.
REMOVE_BG_API_KEY=
